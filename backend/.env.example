# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# External APIs
HUGGINGFACE_API_URL=https://huggingface.co/api/daily_papers

# AI Service (REQUIRED for AI interpretation feature)
# Get your API key from: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Frontend URL (for CORS in production)
# FRONTEND_URL=https://your-frontend-domain.com

# Supabase Database Configuration
# Connect to Supabase via connection pooling (recommended for Prisma)
# connection_limit: Number of concurrent database connections
#   - For local development: 5-10 is recommended
#   - For production with PgBouncer: 3-5 is optimal
#   - MUST be >= DB_CONCURRENCY_LIMIT to avoid timeouts
#   - pool_timeout: Connection acquisition timeout (10 seconds default)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10"

# Direct connection to the database (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Database Concurrency Control
# Maximum concurrent database operations (should be ≤ connection_limit)
# Default: 3 (safe for most configurations)
DB_CONCURRENCY_LIMIT=3

# Automated Paper Prefetching (Cron Jobs)
# Enable/disable automated prefetching
CRON_ENABLED=true

# Cron schedule for paper prefetching (default: daily at midnight)
# Format: minute hour day month weekday
# Examples:
#   - "0 0 * * *" = Daily at midnight (00:00 UTC)
#   - "0 12 * * *" = Daily at noon (12:00 UTC)
#   - "0 6 * * *" = Daily at 6 AM (06:00 UTC)
# Note: Vercel Hobby plan only supports daily cron jobs (once per day)
PREFETCH_CRON_SCHEDULE=0 0 * * *

# Number of recent days to prefetch (default: 3)
PREFETCH_DAYS=3

# Whether to translate abstracts during prefetch (default: true)
TRANSLATE_ON_PREFETCH=true

# Run prefetch immediately on server startup (default: false)
PREFETCH_ON_STARTUP=false

# Timezone for cron scheduling (default: UTC)
TZ=UTC
