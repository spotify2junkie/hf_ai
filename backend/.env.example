# Backend Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# External APIs
HUGGINGFACE_API_URL=https://huggingface.co/api/daily_papers

# AI Services Configuration
# DashScope (REQUIRED for abstract translation)
# Get your API key from: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# SiliconFlow (REQUIRED for full paper explanation)
# Get your API key from: https://siliconflow.cn/
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# Frontend URL (for CORS in production)
# FRONTEND_URL=https://your-frontend-domain.com

# Supabase Database Configuration
# IMPORTANT: Railway/Vercel deployments require specific connection settings
#
# For Railway/Vercel (Serverless):
#   - Use port 6543 (transaction pooler) NOT 5432
#   - Railway doesn't support IPv6, so transaction pooler is required
#   - Set connection_limit=1 for serverless (each invocation = new connection)
#   - Add connect_timeout=30 and pool_timeout=30 to handle network latency
#
# For Local Development:
#   - Can use port 5432 with higher connection_limit (5-10)
#
# Example for Railway/Vercel:
# DATABASE_URL="postgresql://USER:PASSWORD@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30&pool_timeout=30"
#
# Example for Local Development:
# DATABASE_URL="postgresql://USER:PASSWORD@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=5&pool_timeout=10"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&connect_timeout=30&pool_timeout=30"

# Direct connection to the database (used for migrations only)
# Use port 5432 for direct connection (not pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?connect_timeout=30"

# Database Concurrency Control
# Maximum concurrent database operations (should be ≤ connection_limit)
# Default: 3 (safe for most configurations)
DB_CONCURRENCY_LIMIT=3

# Automated Paper Prefetching (Cron Jobs)
# Enable/disable automated prefetching
CRON_ENABLED=true

# Cron schedule for paper prefetching (default: every 6 hours)
# Format: minute hour day month weekday
# Examples:
#   - "0 */6 * * *" = Every 6 hours (00:00, 06:00, 12:00, 18:00 UTC)
#   - "0 0 * * *" = Daily at midnight (00:00 UTC)
#   - "0 12 * * *" = Daily at noon (12:00 UTC)
#   - "0 6 * * *" = Daily at 6 AM (06:00 UTC)
# Note: Vercel Hobby plan only supports daily cron jobs (once per day)
PREFETCH_CRON_SCHEDULE=0 */6 * * *

# Number of recent days to prefetch (default: 3)
PREFETCH_DAYS=3

# Whether to translate abstracts during prefetch (default: true)
TRANSLATE_ON_PREFETCH=true

# Run prefetch immediately on server startup (default: false)
PREFETCH_ON_STARTUP=false

# Timezone for cron scheduling (default: UTC)
TZ=UTC
