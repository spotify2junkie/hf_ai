// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Paper {
  id              String   @id @default(uuid()) @db.Uuid
  paperId         String   @unique @map("paper_id")
  title           String
  authors         Json
  abstract        String?  @db.Text
  abstractZh      String?  @map("abstract_zh") @db.Text
  pdfUrl          String?  @map("pdf_url")
  topics          Json     @default("[]")
  publishedDate   DateTime @map("published_date") @db.Date
  upvotes         Int      @default(0)

  // Metadata
  fetchedAt       DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cacheExpiresAt  DateTime @map("cache_expires_at") @db.Timestamptz(6)

  @@index([publishedDate(sort: Desc)])
  @@index([cacheExpiresAt])
  @@index([publishedDate, paperId])
  @@map("papers")
}
